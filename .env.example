# =============================================================================
# Bayora — Environment Variables
# Copy to .env and change values for production.
# All variables have safe defaults in docker-compose.yml for development.
# =============================================================================

# PostgreSQL
POSTGRES_DB=bayora
POSTGRES_USER=bayora
POSTGRES_PASSWORD=bayora_dev_password

# Control Plane
CONTROL_PLANE_PORT=8000

# JWT signing secret (change in production!)
JWT_SECRET=bayora_dev_jwt_secret_change_me

# HMAC secret for audit chain integrity (change in production!)
HMAC_SECRET=bayora_dev_hmac_secret_change_me
